    <PackageReference Include="SharpCompress" Version="0.50.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="SonarAnalyzer.CSharp" Version="10.29.0.143774" />
  </ItemGroup>
</Project>
