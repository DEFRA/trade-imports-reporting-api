{
  "Mongo": {
    "DatabaseUri": "mongodb://127.0.0.1:27017/?directConnection=true",
    "QueryLogging": true
  },
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:o} [{Level:u4}] {Message} {Properties}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ResourceEventsConsumerOptions": {
    "ConsumersPerHost": 1
  },
  "TracesChedsResourceEventsConsumerOptions": {
    "ConsumersPerHost": 1
  },
  "ChedReservationsResourceEventsConsumerOptions": {
    "ConsumersPerHost": 1
  },
  "ActivityEventsConsumerOptions": {
    "ConsumersPerHost": 1
  },
  "Acl": {
    "Clients": {
      "BtmsFrontend": {
        "Secret": "developer-pwd"
      }
    }
  }
}
